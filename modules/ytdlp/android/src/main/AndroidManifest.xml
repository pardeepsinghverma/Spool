<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!--
    Storage splits three ways by Android generation.

    Publishing a download never needs permission on API 29+: MediaStore lets an
    app insert its own media freely. Below that, writing into Movies/ or Music/
    is ordinary file I/O and does need the grant.

    Reading is the opposite. Once the app is reinstalled — or the row was
    written by a previous install — its own published files count as someone
    else's media, so listing them back requires a read permission. API 33 split
    that single permission into per-type ones.
  -->
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28" />
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

  <!--
    Auto Backup is on (the Expo template sets android:allowBackup="true" on the
    app manifest, which is higher priority than this one) and by default it
    excludes only the cache directories. That put app_webview/ — the WebView's
    cookie jar, and after a sign-in the user's live YouTube session — into
    Google's cloud backup and into device-to-device transfer, where it would be
    restored onto another phone as a working login.

    These two files say what may leave. Both are needed: fullBackupContent is
    read on Android 11 and older, dataExtractionRules on Android 12 and newer,
    and they are written to say the same thing.

    android:allowBackup is deliberately not repeated here. It is already set on
    the generated manifest, and declaring it again in a library manifest is a
    merge conflict rather than an override.
  -->
  <!--
    The network policy is declared rather than left to the platform default.

    Release denies cleartext outright; the debug source set replaces the same
    resource with one that permits it, because the licence server runs on
    Laragon over plain HTTP while it is being built. Left to the default, a
    debug build's request to it is refused before it leaves the phone, and
    `syncLicence` treats a thrown fetch as "no news" by design — so the symptom
    is a server that never receives a request and an app that reports nothing
    wrong. See src/main/res/xml/spool_network_security.xml.
  -->
  <application
    android:fullBackupContent="@xml/spool_backup_rules"
    android:dataExtractionRules="@xml/spool_data_extraction_rules"
    android:networkSecurityConfig="@xml/spool_network_security">
    <service
      android:name=".DownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!--
      Keeps whatever is playing alive once the app is off screen — the browser's
      <video> and the local player both. Declared mediaPlayback so the system
      exempts it from the cached-process freezer and lets it run with the screen
      off, and it takes the MEDIA_BUTTON intent so headset and Bluetooth keys
      reach the session rather than nothing.
    -->
    <service
      android:name=".PlaybackService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON" />
      </intent-filter>
    </service>

    <!--
      MediaSessionCompat looks for this at construction and logs the session as
      unable to receive media buttons without it. It forwards the key to the
      service above, which hands it to the session's own callback.
    -->
    <receiver
      android:name="androidx.media.session.MediaButtonReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MEDIA_BUTTON" />
      </intent-filter>
    </receiver>
  </application>

</manifest>
